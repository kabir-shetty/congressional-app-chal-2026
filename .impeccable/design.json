      "description": "Labeled multiline field inset to the ground color with a 2px field-edge stroke.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">The message</span><textarea class=\"ds-input\" placeholder=\"e.g. a text, email, or DM you received\"></textarea></label>",
      "css": ".ds-field{font-family:-apple-system,Roboto,system-ui,sans-serif;display:flex;flex-direction:column;gap:8px;} .ds-field-label{font-size:20px;line-height:28px;font-weight:600;color:#1F2328;} .ds-input{font-family:-apple-system,Roboto,system-ui,sans-serif;min-height:160px;padding:16px;font-size:20px;line-height:28px;color:#1F2328;background:#F4F8F7;border:2px solid #7C8C89;border-radius:12px;caret-color:#0B6E64;resize:vertical;} .ds-input::placeholder{color:#4F5B66;} .ds-input:focus-visible{outline:3px solid #0B6E64;outline-offset:2px;}"
    },
    {
      "name": "Grouped List",
      "kind": "nav",
      "refersTo": "list-row",
      "description": "Native inset grouped list of destinations with inset hairline separators and chevrons.",
      "html": "<div class=\"ds-list\"><a class=\"ds-row\" href=\"#\"><span class=\"ds-row-text\"><span class=\"ds-row-title\">Spot the Scam</span><span class=\"ds-row-detail\">Practice with five messages.</span></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4F5B66\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg></a><div class=\"ds-sep\"></div><a class=\"ds-row\" href=\"#\"><span class=\"ds-row-text\"><span class=\"ds-row-title\">AI Scams</span><span class=\"ds-row-detail\">How AI changed the tricks.</span></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4F5B66\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg></a></div>",
      "css": ".ds-list{font-family:-apple-system,Roboto,system-ui,sans-serif;background:#FFFFFF;border:1px solid #D7E4E1;border-radius:16px;overflow:hidden;} .ds-row{display:flex;align-items:center;gap:16px;min-height:72px;padding:16px;text-decoration:none;box-sizing:border-box;} .ds-row:hover,.ds-row:active{background:#E3F0ED;} .ds-row:focus-visible{outline:3px solid #0B6E64;outline-offset:-3px;} .ds-row-text{flex:1;display:flex;flex-direction:column;gap:2px;} .ds-row-title{font-size:20px;line-height:28px;font-weight:600;color:#1F2328;} .ds-row-detail{font-size:18px;line-height:25px;color:#4F5B66;} .ds-sep{height:1px;margin-left:16px;background:#D7E4E1;}"

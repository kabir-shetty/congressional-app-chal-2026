    {
      "name": "Instruction Strip",
      "kind": "custom",
      "refersTo": "instruction-strip-band-danger",
      "description": "Signature pharmacy-label panel: status band naming the panel over a tinted body with one plain sentence.",
      "html": "<div class=\"ds-strip ds-strip-danger\"><div class=\"ds-strip-band\">What to do</div><p class=\"ds-strip-text\">Don't reply, click links, or send money.</p></div><div class=\"ds-strip ds-strip-warning\"><div class=\"ds-strip-band\">What to do</div><p class=\"ds-strip-text\">Never pay with gift cards, wire transfers, or crypto.</p></div><div class=\"ds-strip ds-strip-success\"><div class=\"ds-strip-band\">What to do</div><p class=\"ds-strip-text\">Call the person back on a number you already know.</p></div>",
      "css": ".ds-strip{font-family:-apple-system,Roboto,system-ui,sans-serif;border-radius:12px;overflow:hidden;margin-bottom:16px;} .ds-strip-band{padding:8px 16px;font-size:16px;line-height:20px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:#FFFFFF;} .ds-strip-text{margin:0;padding:16px;font-size:20px;line-height:28px;color:#1F2328;} .ds-strip-danger{background:#FDECEA;} .ds-strip-danger .ds-strip-band{background:#B42318;} .ds-strip-warning{background:#FFF3D6;} .ds-strip-warning .ds-strip-band{background:#8A5300;} .ds-strip-success{background:#E5F3E9;} .ds-strip-success .ds-strip-band{background:#1E6B3A;}"
    },
    {

      "html": "<div class=\"ds-shell\"><div class=\"ds-appbar\">Scam Checker</div><div class=\"ds-ground\"></div><nav class=\"ds-tabs\"><span class=\"ds-tab\">Home</span><span class=\"ds-tab ds-tab-active\">Checker</span><span class=\"ds-tab\">Quiz</span><span class=\"ds-tab\">AI Scams</span></nav></div>",
      "css": ".ds-shell{font-family:-apple-system,Roboto,system-ui,sans-serif;border:1px solid #D7E4E1;} .ds-appbar{background:#0B6E64;color:#FFFFFF;padding:14px 16px;font-size:22px;line-height:28px;font-weight:700;} .ds-ground{height:80px;background:#F4F8F7;} .ds-tabs{display:flex;height:68px;padding-top:8px;box-sizing:border-box;background:#FFFFFF;border-top:1px solid #D7E4E1;} .ds-tab{flex:1;text-align:center;font-size:16px;font-weight:600;color:#4F5B66;padding-top:26px;} .ds-tab-active{color:#0B6E64;}"

# Gemini is called through Vertex AI with Google Cloud Application Default
# Credentials (ADC); no Gemini API key. See README for providing ADC.
GOOGLE_CLOUD_PROJECT=replace-with-your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
API_TOKEN=replace-with-a-long-random-token
PORT=8787
# Only when not running on Google Cloud: path INSIDE the container to a
# mounted credentials file (see README).
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/adc.json

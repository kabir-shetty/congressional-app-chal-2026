# Copy to .env.local and fill in. Values are inlined into the app bundle.
# Base URL of the Porch Watch AI server (server/). Use your machine's LAN IP,
# not localhost, when testing on a phone.
EXPO_PUBLIC_AI_API_URL=http://192.168.1.10:8080
# Must match API_TOKEN in server/.env.
EXPO_PUBLIC_AI_API_TOKEN=replace-with-server-api-token
